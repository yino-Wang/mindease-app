// MindEase — PRD-derived schema (Supabase PostgreSQL)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Full Supabase connection pooler support
}

generator client {
  provider = "prisma-client-js"
}

// 1. User table (ID mapped to Supabase Auth)
model User {
  id             String               @id @default(uuid())
  email          String               @unique
  username       String?              @unique
  avatarUrl      String?
  authMethod     String? // "password" | "magic_link"
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  logs           UserMeditationLog[]
  courseProgress UserCourseProgress[]
  watchHistory   UserWatchHistory[]
  videoComments  VideoComment[]
  calendarNotes  ZenCalendarNote[]

  @@map("users")
}

// 2. Media audio/video table (system soundscapes, course audio, category libraries)
model MeditationAudio {
  id           String              @id @default(uuid())
  name         String
  url          String // Supabase Storage CDN URL or external stream (YouTube)
  bgVideoUrl   String? // Muted loop background video URL (PRD Appendix A.2)
  category     String // nature | zen | course | daily | MIXER | MORNINGS | SLEEP
  introduction String?             @db.Text
  coverUrl     String?
  author       String?
  sortOrder    Int                 @default(0)
  published    Boolean             @default(true)
  duration     Int? // Preset audio duration in seconds; nullable for free timer
  createdAt    DateTime            @default(now())
  logs         UserMeditationLog[]
  courseStep   CourseStep? // If course audio, reverse relation to course step

  @@index([category, sortOrder])
  @@map("meditation_audios")
}

// 3. Structured course and step tables (3-day course gating)
model Course {
  id          String               @id @default(uuid())
  title       String
  description String
  createdAt   DateTime             @default(now())
  steps       CourseStep[]
  progresses  UserCourseProgress[]

  @@map("courses")
}

model CourseStep {
  id          String          @id @default(uuid())
  courseId    String
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  audioId     String          @unique
  audio       MeditationAudio @relation(fields: [audioId], references: [id])
  daySequence Int // e.g. Day 1 = 1, Day 2 = 2
  title       String // e.g. "Awakening Breath"
  createdAt   DateTime        @default(now())

  @@unique([courseId, daySequence]) // Unique day sequence per course
  @@map("course_steps")
}

// 4. User course progress (prerequisite unlock gating)
model UserCourseProgress {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  currentSequence Int      @default(1) // Current unlocked day sequence for this course
  updatedAt       DateTime @updatedAt

  @@unique([userId, courseId])
  @@map("user_course_progresses")
}

// 5. Meditation log (powers energy glow calendar)
model UserMeditationLog {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  audioId   String? // Nullable for free timer or AI-generated sessions
  audio     MeditationAudio? @relation(fields: [audioId], references: [id], onDelete: SetNull)
  duration  Int // Actual meditation duration in seconds
  logType   String // "TIMER" (free timer), "COURSE" (micro-course), "AI" (AI guide)
  aiScript  String? // When logType is AI, persist LLM-generated meditation script text
  createdAt DateTime         @default(now())
  journal   UserJournal?

  @@map("user_meditation_logs")
}

// 6. Dashboard streaming catalog (Video Spotlight + Made For You)
model StreamingItem {
  id          String   @id @default(uuid())
  sectionType String // "SPOTLIGHT" | "MADE_FOR_YOU"
  title       String
  description String   @db.Text
  videoUrl    String // Supabase Storage CDN URL (mp4 loop or audio guide)
  coverUrl    String // Public path e.g. /cover/1.jpg
  duration    Int // seconds
  rating      Float    @default(4.8)
  playCount   Int      @default(0)
  author      String?
  tags        String   @default("") // Comma-separated display tags
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([sectionType, sortOrder])
  @@map("streaming_items")
}

// 8. Per-user video watch history (profile Watch History tab)
model UserWatchHistory {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType     String // "STREAMING" | "LIBRARY"
  contentId       String // streaming_items.id or meditation_audios.id
  title           String
  coverUrl        String
  href            String
  durationSeconds Int?
  lastWatchedAt   DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([userId, contentType, contentId])
  @@index([userId, lastWatchedAt(sort: Desc)])
  @@map("user_watch_history")
}

// 9. Comments on video / library detail pages
model VideoComment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType String // "STREAMING" | "LIBRARY"
  contentId   String
  body        String   @db.Text
  createdAt   DateTime @default(now())

  @@index([contentType, contentId, createdAt(sort: Desc)])
  @@map("video_comments")
}

// 10. Per-day notes on the dashboard Zen Calendar
model ZenCalendarNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // UTC day key YYYY-MM-DD
  body      String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
  @@map("zen_calendar_notes")
}

// 7. Zen journal (strict character limit)
model UserJournal {
  id        String            @id @default(uuid())
  logId     String            @unique
  log       UserMeditationLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  content   String // Enforce 50-character max in app or DB validation
  createdAt DateTime          @default(now())

  @@map("user_journals")
}
